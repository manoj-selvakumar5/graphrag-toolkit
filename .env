# AWS Configuration
AWS_REGION=us-east-1

# GraphRAG Toolkit Configuration
# These will be populated after stack deployment
GRAPH_STORE=
VECTOR_STORE=
EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
EXTRACTION_MODEL=anthropic.claude-3-haiku-20240307-v1:0
RESPONSE_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Stack Configuration (optional - customize as needed)
APPLICATION_ID=my-graphrag
NOTEBOOK_INSTANCE_TYPE=ml.m5.xlarge
PROVISIONED_MEMORY=16
